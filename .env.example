# Ato Mobile App - Environment Variables

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-api-url.com/api

# Enable mock API (set to 'true' to use mock data without Supabase)
# If API_BASE_URL is empty, mock mode will be enabled automatically
EXPO_PUBLIC_USE_MOCK_API=false

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI Configuration
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key

# LiveKit Configuration (for audio/video calls)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-livekit-url.com
EXPO_PUBLIC_LIVEKIT_API_KEY=your-livekit-api-key
EXPO_PUBLIC_LIVEKIT_API_SECRET=your-livekit-api-secret